---
import '@fontsource-variable/fraunces';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import ogSource from '../assets/mario-seitlich.jpg';
import { SITE, ORTSZEILE, GESCHICHTE_SICHTBAR } from '../site.config';

interface Props {
  /** Seitentitel für Google und Browser-Tab, höchstens etwa 60 Zeichen */
  title: string;
  /** Beschreibung für Google, höchstens etwa 155 Zeichen */
  description: string;
  /** Strukturierte Daten (JSON-LD), je Seite */
  jsonLd?: object[];
}

const { title, description, jsonLd = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogSource, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const isHome = Astro.url.pathname === '/';
const home = isHome ? '' : '/';

const nav = [
  { href: `${home}#wer-ich-bin`, label: 'Wer ich bin' },
  { href: `${home}#fuer-wen`, label: 'Für wen' },
  { href: `${home}#wie-ich-arbeite`, label: 'Wie ich arbeite' },
  { href: `${home}#angebot`, label: 'Angebot' },
  ...(GESCHICHTE_SICHTBAR ? [{ href: '/meine-geschichte', label: 'Meine Geschichte' }] : []),
  { href: `${home}#fragen`, label: 'Fragen' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Vorbehalt gegen Text und Data Mining nach § 44b UrhG, maschinenlesbar (TDM Reservation Protocol) -->
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <style>
      .site-header { position: sticky; top: 0; z-index: 50; background: rgba(20, 18, 15, 0.94); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); }
      .site-header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; }
      .logo { font-family: var(--font-display); font-size: 22px; color: var(--text); text-decoration: none; }
      .nav-list { display: flex; flex-wrap: wrap; gap: 4px 24px; list-style: none; margin: 0; padding: 0; font-size: 15px; }
      .nav-list a { color: var(--text); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
      .nav-list a:hover { color: var(--accent-hover); }
      .nav-cta { color: var(--accent) !important; font-weight: 600; }
      /* Menü auf allen Bildschirmen zugeklappt, Button „Menü“ in der Kopfzeile (Entscheidung Mario, 31.10.2026) */
      .menu { position: relative; }
      .menu summary { list-style: none; cursor: pointer; min-height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); padding: 0 16px; font-size: 15px; }
      .menu summary::-webkit-details-marker { display: none; }
      .menu[open] summary { border-color: var(--accent); }
      .menu[open] .nav-list { position: absolute; right: 0; top: 100%; flex-direction: column; flex-wrap: nowrap; background: var(--bg); border: 1px solid var(--line-strong); padding: 12px 20px; min-width: 240px; }
      .site-footer { border-top: 1px solid var(--line); padding: 40px 0 56px; color: var(--text-faint); font-size: 15px; }
      .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; }
      .site-footer a { color: var(--text-faint); }
      .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
      .footer-links a { display: inline-flex; min-height: 44px; align-items: center; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">{SITE.name}</a>
        <details class="menu">
          <summary aria-label="Menü öffnen">Menü</summary>
          <nav aria-label="Hauptnavigation">
            <ul class="nav-list">
              {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
              <li><a class="nav-cta" href={`${home}#kontakt`}>Erstgespräch</a></li>
            </ul>
          </nav>
        </details>
      </div>
    </header>
    <script>
      // Menü: am Rechner öffnet es beim Überfahren mit der Maus, am Handy beim Tippen
      // (Entscheidung Mario, 31.10.2026). Tippen und Tastatur laufen über das details-Element.
      const menu = document.querySelector<HTMLDetailsElement>('.menu');
      if (menu && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        menu.addEventListener('mouseenter', () => { menu.open = true; });
        menu.addEventListener('mouseleave', () => { menu.open = false; });
        // Ein Klick auf „Menü“ soll das schon offene Menü nicht wieder schließen
        menu.querySelector('summary')?.addEventListener('click', (e) => { e.preventDefault(); menu.open = true; });
      }
      // Mit der Escape-Taste schließen
      menu?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
    </script>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>{SITE.brand}</p>
          <p>{ORTSZEILE}</p>
          <p>© {new Date().getFullYear()} {SITE.name}</p>
        </div>
        <div class="footer-links">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          {SITE.social.linkedin && <a href={SITE.social.linkedin} rel="me noopener">LinkedIn</a>}
          {SITE.social.instagram && <a href={SITE.social.instagram} rel="me noopener">Instagram</a>}
        </div>
      </div>
    </footer>
  </body>
</html>
