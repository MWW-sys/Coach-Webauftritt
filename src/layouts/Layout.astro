---
import '@fontsource-variable/fraunces';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/500.css';
import '@fontsource/manrope/600.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
// Vorschaubild beim Teilen (WhatsApp, LinkedIn): Querformat 1200 × 630, Gesicht ganz im Bild (Mario, 02.11.2026)
import ogSource from '../assets/og-vorschau.jpg';
import { SITE, ORTSZEILE, ZERTIFIKAT_KOPF } from '../site.config';

interface Props {
  /** Seitentitel für Google und Browser-Tab, höchstens etwa 60 Zeichen */
  title: string;
  /** Beschreibung für Google, höchstens etwa 155 Zeichen */
  description: string;
  /** Strukturierte Daten (JSON-LD), je Seite */
  jsonLd?: object[];
  /** Nur Startseite: die H1 steht klein in der Kopfzeile unter dem Namen, in Teilen, je Teil eine Zeile.
      Reihenfolge: zuerst der Zielgruppensatz, dahinter die Orte (Mario, Entscheidungsraum, 01.11.2026) */
  kopfH1?: string[];
}

const { title, description, jsonLd = [], kopfH1 } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const og = await getImage({ src: ogSource, width: 1200, format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site).href;
const isHome = Astro.url.pathname === '/';
const home = isHome ? '' : '/';

// Menü: Reihenfolge und Namen von Mario in der Designwerkstatt, 01.11.2026.
// „Zahl, was du kannst“ nach „Mein Angebot“ (Vorschlag Design, bis Mario anders entscheidet).
// „Meine Geschichte“ steht nicht im Menü, „Wer ich bin“ führt zum Button dorthin (Mario, 01.11.2026).
const zahlHref = `${home}#zahl-was-du-kannst`;
const nav = [
  { href: `${home}#fuer-wen`, label: 'Für wen das ist' },
  { href: `${home}#wer-ich-bin`, label: 'Wer ich bin' },
  { href: `${home}#wie-ich-arbeite`, label: 'Wie ich arbeite' },
  { href: `${home}#angebot`, label: 'Mein Angebot' },
  { href: zahlHref, label: 'Zahl, was du kannst' },
  { href: `${home}#fragen`, label: 'Deine Fragen' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Vorbehalt gegen Text und Data Mining nach § 44b UrhG, maschinenlesbar (TDM Reservation Protocol) -->
    <meta name="tdm-reservation" content="1" />
    <link rel="canonical" href={canonical} />
    <!-- Icon: MW in Orange auf Dunkel (Mario, 01.11.2026) -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Mario Wochner, Coach" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}

    <style>
      /* Kopfzeile: am Rechner läuft alles mit (Name, Zertifikat, H1, Menü).
         Am Handy läuft nur die Leiste mit Name und „Menü“ mit, Zertifikat und H1 scrollen weg (Mario, 01.11.2026). */
      .kopf { position: sticky; top: 0; z-index: 50; background: rgba(20, 18, 15, 0.94); backdrop-filter: blur(6px); border-bottom: 1px solid var(--line); }
      .kopf-innen { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "name rechts" "unter rechts"; align-content: center; column-gap: 16px; row-gap: 2px; min-height: 72px; padding-top: 8px; padding-bottom: 8px; }
      .site-header { display: contents; }
      .marke-zeile { grid-area: name; display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 10px; min-width: 0; }
      .kopf-rechts { grid-area: rechts; align-self: center; display: flex; align-items: center; gap: 24px; flex-shrink: 0; }
      .kopf-unter { grid-area: unter; min-width: 0; }
      /* H1 klein unter dem Namen, bündig links, wie ein Untertitel (Mario, 01.11.2026) */
      .kopf-h1 { margin: 0; font-family: var(--font-body); font-size: 13px; font-weight: 500; line-height: 1.45; letter-spacing: 0.02em; color: var(--text-faint); max-width: 620px; }
      .kopf-h1-teil { display: block; }
      .kopf-zert { font-family: var(--font-body); font-size: 14px; font-weight: 500; color: var(--text-muted); display: inline-flex; gap: 10px; }
      .kopf-zert--handy { display: none; }
      @media (max-width: 760px) {
        .kopf, .kopf-innen { display: contents; }
        .site-header { display: flex; position: sticky; top: 0; z-index: 50; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; padding: 8px var(--gutter); background: rgba(20, 18, 15, 0.94); backdrop-filter: blur(6px); }
        .kopf-unter { display: block; padding: 0 var(--gutter) 10px; border-bottom: 1px solid var(--line); }
        .marke-zeile .kopf-zert { display: none; }
        .kopf-zert--handy { display: block; font-size: 12px; margin-bottom: 2px; }
        .kopf-h1 { font-size: 12px; }
      }
      .logo { font-family: var(--font-display); font-size: 22px; color: var(--text); text-decoration: none; }
      .nav-list { display: flex; flex-wrap: wrap; gap: 4px 24px; list-style: none; margin: 0; padding: 0; font-size: 15px; }
      .nav-list a { color: var(--text); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
      .nav-list a:hover { color: var(--accent-hover); }
      .nav-cta { color: var(--accent) !important; font-weight: 600; }
      /* Menü auf allen Bildschirmen zugeklappt, Button „Menü“ in der Kopfzeile (Entscheidung Mario, 31.10.2026) */
      .kopf-zahl { font-size: 14px; font-weight: 600; color: var(--accent); text-decoration: none; display: inline-flex; min-height: 44px; align-items: center; }
      .kopf-zahl:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 4px; }
      @media (max-width: 760px) { .kopf-zahl { display: none; } }
      .menu { position: relative; }
      .menu summary { list-style: none; cursor: pointer; min-height: 44px; min-width: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); padding: 0 16px; font-size: 15px; }
      .menu summary::-webkit-details-marker { display: none; }
      .menu[open] summary { border-color: var(--accent); }
      .menu[open] .nav-list { position: absolute; right: 0; top: 100%; flex-direction: column; flex-wrap: nowrap; background: var(--bg); border: 1px solid var(--line-strong); padding: 12px 20px; min-width: 240px; }
      .site-footer { border-top: 1px solid var(--line); padding: 40px 0 56px; color: var(--text-faint); font-size: 15px; }
      .site-footer .wrap { display: flex; flex-wrap: wrap; gap: 12px 32px; justify-content: space-between; }
      .site-footer a { color: var(--text-faint); }
      .footer-links { display: flex; flex-wrap: wrap; gap: 8px 24px; }
      .footer-links a { display: inline-flex; min-height: 44px; align-items: center; }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>

    <div class="kopf">
      <div class="wrap kopf-innen">
        <header class="site-header">
          <!-- IHK-Zertifikat in der Zeile neben dem Namen, kleiner (Vorschlag Design, Mario, 01.11.2026) -->
          <div class="marke-zeile">
            <a class="logo" href="/">{SITE.name}</a>
            <span class="kopf-zert"><span class="zert-trenner" aria-hidden="true">·</span>{ZERTIFIKAT_KOPF}</span>
          </div>
          <div class="kopf-rechts">
            <!-- „Zahl, was du kannst“ klein in Orange neben „Menü“, nur am Rechner (Mario, Designwerkstatt, 01.11.2026) -->
            <a class="kopf-zahl" href={zahlHref}>Zahl, was du kannst</a>
            <details class="menu">
              <summary aria-label="Menü öffnen">Menü</summary>
              <nav aria-label="Hauptnavigation">
                <ul class="nav-list">
                  {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
                  <li><a class="nav-cta" href={`${home}#kontakt`}>Kontakt</a></li>
                </ul>
              </nav>
            </details>
          </div>
        </header>
        <div class="kopf-unter">
          <!-- Am Handy steht das Zertifikat hier, unter der mitlaufenden Leiste -->
          <p class="kopf-zert kopf-zert--handy">{ZERTIFIKAT_KOPF}</p>
          {kopfH1 && <h1 class="kopf-h1">{kopfH1.map((teil, i) => <>{i > 0 && ' '}<span class="kopf-h1-teil">{teil}</span></>)}</h1>}
        </div>
      </div>
    </div>
    <script>
      // Menü: am Rechner öffnet es beim Überfahren mit der Maus, am Handy beim Tippen
      // (Entscheidung Mario, 31.10.2026). Tippen und Tastatur laufen über das details-Element.
      const menu = document.querySelector<HTMLDetailsElement>('.menu');
      if (menu && window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        menu.addEventListener('mouseenter', () => { menu.open = true; });
        menu.addEventListener('mouseleave', () => { menu.open = false; });
        // Ein Klick auf „Menü“ soll das schon offene Menü nicht wieder schließen
        menu.querySelector('summary')?.addEventListener('click', (e) => { e.preventDefault(); menu.open = true; });
      }
      // Sprünge aus dem Menü landen unter der Kopfzeile, auch wenn sie am Handy höher ist
      // Gemessen wird, was mitläuft: am Rechner die ganze Kopfzeile, am Handy nur die Leiste
      const kopfHoehe = () => {
        const ganz = document.querySelector<HTMLElement>('.kopf');
        const leiste = document.querySelector<HTMLElement>('.site-header');
        const mit = ganz && getComputedStyle(ganz).display !== 'contents' ? ganz : leiste;
        if (mit) document.documentElement.style.scrollPaddingTop = `${mit.offsetHeight + 12}px`;
      };
      kopfHoehe();
      window.addEventListener('resize', kopfHoehe);
      // Neu laden führt immer nach oben (Mario, 02.11.2026). Ohne das stellt der Browser die alte Position
      // wieder her, und weil Schriften und Bilder nachladen, landet man jedes Mal an einer anderen Stelle.
      // Ein geteilter Link mit Sprungziel (zum Beispiel #kontakt) funktioniert beim ersten Öffnen weiter.
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
      const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      if (nav?.type === 'reload') {
        if (location.hash) history.replaceState(null, '', location.pathname + location.search);
        window.scrollTo(0, 0);
      }
      // Mit der Escape-Taste schließen
      menu?.addEventListener('keydown', (e) => { if (e.key === 'Escape') { menu.open = false; menu.querySelector('summary')?.focus(); } });
    </script>

    <main id="inhalt">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <p>{SITE.brand}</p>
          <p>{ORTSZEILE}</p>
          <p>© {new Date().getFullYear()} {SITE.name}</p>
        </div>
        <div class="footer-links">
          <a href="/impressum">Impressum</a>
          <a href="/datenschutz">Datenschutz</a>
          {SITE.social.linkedin && <a href={SITE.social.linkedin} rel="me noopener">LinkedIn</a>}
          {SITE.social.instagram && <a href={SITE.social.instagram} rel="me noopener">Instagram</a>}
        </div>
      </div>
    </footer>
  </body>
</html>
