---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import marioImg from '../assets/mario.jpg';
const { default: FuerWenContent } = await import('../content/fuer-wen.md');
const { default: FuerWenNichtContent } = await import('../content/fuer-wen-nicht.md');
const { default: AngebotContent } = await import('../content/angebot.md');
const { default: UeberMichContent } = await import('../content/ueber-mich.md');
---

<BaseLayout title="Mario Wochner – Coaching aus Erfahrung" description="Coaching für Menschen, die geliefert haben und trotzdem nachts wach liegen. Nicht nur warum. Vor allem wie und wo. Online und vor Ort in Bielefeld, Hannover, Wolfsburg und Berlin.">

  <!-- Hero / Startseite -->
  <section id="start" class="hero-section">
    <p class="hero-text">Schon wieder aufgewacht. 3&nbsp;Uhr 33. Warum...?</p>
  </section>

  <!-- Für wen das ist -->
  <section id="fuer-wen" class="page-section">
    <FuerWenContent />
  </section>

  <!-- Für wen das nichts ist -->
  <section id="fuer-wen-nicht" class="page-section">
    <FuerWenNichtContent />
  </section>

  <!-- Mein Angebot -->
  <section id="angebot" class="page-section">
    <AngebotContent />
  </section>

  <!-- Über mich -->
  <section id="ueber-mich" class="page-section ueber-mich-section">
    <div class="ueber-mich-image-wrap">
      <Image src={marioImg} alt="Mario Wochner" width={680} height={853} format="webp" class="ueber-mich-img" />
    </div>
    <div class="ueber-mich-text">
      <UeberMichContent />
    </div>
  </section>

  <!-- Kontakt -->
  <section id="kontakt" class="page-section page-section--last">
    <h2>Kontakt</h2>
    <p>Wenn du das Gefühl hast, hier könnte etwas anfangen — schreib mir.</p>
    <p>Ich antworte persönlich. Nicht in einer Stunde. Aber innerhalb weniger Tage. Und nicht mit einer Vorlage.</p>
    <p><a href="mailto:mario.wochner@t-online.de">mario.wochner@t-online.de</a></p>
    <a href="tel:015563417899" style="display:block; margin-top:0.3rem;">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 220 28" style="display:block; max-width:100%; height:auto;" aria-label="Telefonnummer" role="img">
        <text x="0" y="22" font-family="'Lora', Georgia, serif" font-size="20" fill="#e8e4dc">015563417899</text>
      </svg>
    </a>
  </section>

</BaseLayout>
