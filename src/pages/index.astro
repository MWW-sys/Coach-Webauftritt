---
// Startseite Version 1. Aufbau nach der Seitenstruktur (Projektstand, Schritt 1, 10 Abschnitte),
// Aussehen nach dem Canvas „Webseite und Buchcover", Artboard Main.
// Texte: Entwürfe aus dem Dokument „Website-Texte" (Stand 31.10.2026) und aus dem Canvas.
// Entwürfe dürfen in die Vorschau. Live geht nur, was Mario freigegeben hat.
// Text in eckigen Klammern fehlt noch und kommt aus der Textwerkstatt.
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
// Fotos im Einstieg und bei Kontakt getauscht (Mario, 03.11.2026)
import fotoEinstieg from '../assets/mario-see-kontakt.jpg';
import fotoArbeitszimmer from '../assets/mario-arbeitszimmer.jpg';
import fotoKontakt from '../assets/mario-see-einstieg.jpg';
import fotoGeschichte from '../assets/mario-auto.jpg';
import fotoCafe from '../assets/mario-cafe-neu.jpg';
import { SITE, VORSCHAU, GESCHICHTE_SICHTBAR, BESCHREIBUNG, ZERTIFIKAT_ERHALTEN } from '../site.config';

// Name vorn, damit die Startseite bei der Suche nach dem Namen gefunden wird (Mario, Textwerkstatt, 02.11.2026)
const title = 'Mario Wochner · Coaching Berlin, Wolfsburg, Hannover, online';
const description = BESCHREIBUNG;

// Häufige Fragen, Reihenfolge und neue Fragen freigegeben von Mario am 02.11.2026 (Textwerkstatt)
const fragen = [
  {
    frage: 'Was passiert im kostenlosen Erstgespräch?',
    antwort: [
      'Das Erstgespräch ist kostenlos und unverbindlich. Wir schauen, worum es dir geht und ob wir zusammenpassen. Wichtig ist mir, dass ich dir an der Stelle begegne, wo du mit deinem Thema bist. Ich erzähle dir auch, mit welchen Methoden ich arbeiten kann, und frage dich, ob das für dich passt.',
    ],
  },
  {
    frage: 'Warum fällt es mir so schwer, Grenzen zu setzen?',
    antwort: [
      'Oft merkst du es erst hinterher: wieder zu viel zugesagt, wieder nichts gesagt. Das ist kein fehlender Wille. Es ist ein Muster, das dir noch nicht bewusst ist. Im Coaching schauen wir genau auf diese Stelle: wo es passiert und woran es liegt.',
    ],
  },
  {
    frage: 'Warum kann ich nicht Nein sagen?',
    antwort: [
      'Eigentlich weißt du ganz genau, dass du Nein meinst. Und trotzdem kommt ein Ja heraus. Auch das ist ein Muster. Wir schauen auf den Moment, in dem das Ja kommt, und darauf, was du dort brauchst, um für dich einzustehen.',
    ],
  },
  {
    frage: 'Wie läuft eine Stunde bei dir ab?',
    antwort: [
      'Am Anfang gehört der Raum dir. Am Ende hast du einen Schritt für den nächsten Tag, von dir selbst gefunden. Was dazwischen passiert, steht bei <a href="#wie-ich-arbeite">‚Wie ich arbeite‘</a>.',
    ],
  },
  {
    frage: 'Was tun gegen innere Leere?',
    antwort: [
      'Erst als ich aufhörte zu fragen, warum, und anfing zu fragen, wie sich dieses Gefühl anfühlt und wo es sitzt, wurde es ruhiger. Ich wandte mich ihm zu und blieb bei ihm.',
      'Im Coaching mit mir geht es nicht darum, dass die Leere, die Schwere oder was auch immer du mitbringst, weggemacht wird. Sondern darum, dass ich genau an dieser Stelle mit dir stehen bleibe und wir gemeinsam hinschauen.',
    ],
  },
  {
    frage: 'Warum fühle ich mich leer, obwohl ich alles erreicht habe?',
    antwort: [
      'Du hast über lange Zeit gelernt, für das Außen zu liefern. Und das Innen hast du lange auf Pause gestellt. Irgendwann hat es sich zurückgezogen, weil es da nichts zu tun hatte.',
      'Ich kenne das Gefühl, dass etwas fehlt, obwohl alles da ist.',
    ],
  },
  {
    frage: 'Warum gerate ich immer wieder an die Falschen?',
    antwort: [
      'Wenn sich etwas immer wiederholt, lohnt der Blick auf das Muster dahinter. Das gilt in der Liebe genauso wie bei der Arbeit, in der Familie und unter Freunden.',
      'Der Weg zu dir selbst scheitert selten an fehlendem Willen. Er scheitert daran, dass dein Wille und das, was dich schützt, dasselbe wollen, aber gegeneinander kämpfen statt miteinander.',
    ],
  },
  {
    frage: 'Coaching oder Therapie: Woher weiß ich, was ich brauche?',
    antwort: [
      'Ich arbeite nicht mit Diagnosen, sondern mit dem, was du erlebst. Coaching ersetzt keine Therapie. Wenn du in therapeutischer Behandlung bist, sprich bitte mit deiner Therapeutin oder deinem Therapeuten, ob Coaching gerade sinnvoll für dich ist.',
    ],
  },
  {
    frage: 'Was kostet ein Coaching?',
    antwort: [
      'Das Erstgespräch ist kostenlos. Einzelcoaching kostet 80 € für 60 Minuten und 120 € für 90 Minuten, zwei Sitzungen zu 90 Minuten 220 €, drei 300 €. Als Paar zahlt ihr 110 € für 60 Minuten und 160 € für 90 Minuten, zwei Sitzungen zu 90 Minuten 300 €, drei 420 €. Dazu gibt es jeden Monat 8 Termine, bei denen du zahlst, was du kannst, auch als Paar.',
      'Pakete kannst du jederzeit beenden, ohne Abo und ohne Bindung. Die genutzten Stunden rechne ich dann zum Einzelpreis ab, den Rest bekommst du zurück. Du zahlst also nie mehr, als wenn du einzeln gebucht hättest.',
      'Musst du einen festen Termin absagen, sag mir bitte mindestens 48 Stunden vorher Bescheid. Sagst du später ab, berechne ich den halben Preis, ab 24 Stunden vorher 75 Prozent und am Tag des Termins den vollen Preis.',
    ],
  },
  {
    frage: 'Warum wache ich immer um 3 Uhr nachts auf?',
    antwort: [
      'Es ist nichts kaputt mit dir. Das Aufwachen ist kein Fehler. Es kann ein Zeichen sein, dass du da drin noch was anderes brauchst.',
      'Wenn du über längere Zeit schlecht schläfst, lass das bitte ärztlich abklären. Im Coaching geht es um das, was dich innerlich wach hält.',
    ],
  },
];

// Strukturierte Daten für Google (unsichtbar): Website „Mario Wochner“, die Person dazu mit ihren Profilen, das Angebot.
// Freigegeben von Mario am 02.11.2026. Profile kommen aus SITE.social, ein leerer Eintrag fehlt einfach.
const startUrl = new URL('/', Astro.site).href;
const profile = Object.values(SITE.social).filter(Boolean);
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': `${startUrl}#website`,
    name: SITE.name,
    url: startUrl,
    inLanguage: 'de',
    publisher: { '@id': `${startUrl}#person` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    '@id': `${startUrl}#person`,
    name: SITE.name,
    url: startUrl,
    jobTitle: 'Systemischer Coach',
    ...(profile.length ? { sameAs: profile } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: SITE.brand,
    url: startUrl,
    email: SITE.email,
    telephone: SITE.phone,
    areaServed: [...SITE.orte.map((ort) => ({ '@type': 'City', name: ort })), { '@type': 'Place', name: 'Online' }],
    priceRange: '80 € bis 420 €',
    founder: { '@id': `${startUrl}#person` },
  },
];

// Bis ein Buchungstool steht, führen die Buttons zu Mail und Telefon im Abschnitt Kontakt (Entscheidung Mario, 31.10.2026).
const buchung = SITE.bookingUrl || '#kontakt';
const mailErstgespraech = SITE.bookingUrl || `mailto:${SITE.email}?subject=${encodeURIComponent('Kostenloses Erstgespräch')}`;
---

<Layout title={title} description={description} jsonLd={jsonLd} kopfH1={['für Menschen, bei denen sich immer wieder dasselbe Muster zeigt, im Job wie in Beziehungen', 'Coaching in Berlin, Wolfsburg, Hannover und online']}>
  <style>
    /* Einstieg: Button und „Wer ich bin“ rechts unter dem Foto, damit der Text links Luft hat (Mario, 31.10.2026).
       Am Handy steht der Button vor dem Foto, damit er früh zu sehen ist. */
    .hero .wrap { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px); grid-template-areas: "text foto" "text aktionen"; column-gap: 72px; row-gap: 24px; align-items: center; padding-top: 72px; padding-bottom: 72px; }
    .hero-text { grid-area: text; min-width: 0; display: flex; flex-direction: column; }
    .hero-foto { grid-area: foto; min-width: 0; display: flex; justify-content: center; align-self: end; }
    /* Unter dem Foto: zuerst „Wer ich bin“, darunter der Button, beide bündig mit der linken Bildkante (Mario, 01.11.2026) */
    .actions.hero-aktionen { grid-area: aktionen; align-self: start; flex-direction: column; align-items: flex-start; gap: 12px; padding-top: 0; }
    @media (max-width: 760px) {
      .hero .wrap { grid-template-columns: minmax(0, 1fr); grid-template-areas: "text" "aktionen" "foto"; row-gap: 32px; }
    }
    .hero-foto img { width: 100%; max-width: 400px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; }
    /* Einstieg B, Maße aus dem Design-Canvas (Mario, 02.11.2026) */
    .uhrzeit { font-family: var(--font-display); font-weight: 300; font-size: 20px; line-height: 1.3; color: var(--text-faint); }
    .einstieg-strich { display: block; width: 56px; height: 1px; background: var(--line-strong); margin: 28px 0; }
    .leitsatz { font-family: var(--font-display); font-weight: 300; font-size: 60px; line-height: 1.06; letter-spacing: -0.02em; max-width: 600px; color: var(--text); }
    .leitzeile { font-family: var(--font-body); font-size: 27px; line-height: 1.4; color: var(--text-muted); margin-top: 22px; max-width: 600px; }
    @media (max-width: 760px) {
      .uhrzeit { font-size: 17px; }
      .einstieg-strich { width: 44px; margin: 18px 0; }
      .leitsatz { font-size: 36px; line-height: 1.08; letter-spacing: -0.01em; }
      .leitzeile { font-size: 21px; margin-top: 16px; }
    }
    .actions { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; padding-top: 8px; }

    .szene .wrap { padding-bottom: 96px; }
    .szene .stack { max-width: 680px; gap: 20px; color: var(--text-muted); font-size: 20px; }
    .szene .gedanke { font-family: var(--font-display); font-size: clamp(26px, 3vw, 32px); color: var(--text); line-height: 1.25; }

    .trenner { max-width: var(--max); margin: 0 auto; padding: 0 var(--gutter); }
    .trenner div { height: 1px; background: var(--line); }

    .hell { background: var(--bg-light); color: var(--text-on-light); }
    .hell .wrap { padding-top: 112px; padding-bottom: 112px; }
    .hell a { color: var(--accent-on-light); }
    .hell .button, .hell .button:hover { color: var(--bg); }
    .hell .label { color: #5E564B; }
    .zweispaltig { display: flex; flex-wrap: wrap; gap: 56px; align-items: flex-start; }
    .zweispaltig > * { flex: 1 1 360px; min-width: 0; }
    .gross-zitat { font-family: var(--font-display); font-weight: 300; font-size: clamp(34px, 4.5vw, 48px); line-height: 1.12; letter-spacing: -0.01em; }
    /* Wie ich arbeite: Zitat in drei Zeilen, Zeile 2 und 3 mittig (Mario, 01.11.2026) */
    .wer-raster .gross-zitat.zitat-dreizeilig { font-size: clamp(24px, 3.1vw, 40px); }
    @media (max-width: 760px) { .wer-raster .gross-zitat.zitat-dreizeilig { font-size: clamp(22px, 6.6vw, 34px); } }
    .zitat-dreizeilig span { display: block; }
    .zitat-dreizeilig .mittig { text-align: center; }
    .label { font-family: var(--font-body); font-size: 14px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-faint); font-weight: 600; line-height: 1.4; }

    /* Wer ich bin: Zitat und Bild links, Text rechts. Das Bild hängt unten in den dunklen Bereich hinein
       (Wunsch Mario, 31.10.2026). Der nächste Abschnitt hält dafür oben mehr Abstand. */
    #wer-ich-bin { position: relative; z-index: 1; }
    #wer-ich-bin .wrap { padding-top: 1.5cm; }
    .wer-raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-areas: "zitat text" "foto text"; column-gap: 72px; row-gap: 40px; align-items: start; }
    .wer-raster .gross-zitat { grid-area: zitat; font-size: clamp(32px, 3.8vw, 44px); }
    .wer-raster .spalte { grid-area: text; }
    .wer-foto { grid-area: foto; width: 100%; max-width: 340px; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 30%; margin-bottom: -176px;
      /* ragt 64 px ins Dunkle; der untere Rand mit der Wiese läuft kurz vor der Kante weich aus */
      -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 84px), rgba(0, 0, 0, 0.92) calc(100% - 64px), rgba(0, 0, 0, 0.35) calc(100% - 28px), transparent 100%);
      mask-image: linear-gradient(to bottom, #000 calc(100% - 84px), rgba(0, 0, 0, 0.92) calc(100% - 64px), rgba(0, 0, 0, 0.35) calc(100% - 28px), transparent 100%); }
    /* Wie ich arbeite: Foto aus dem Café unter dem Zitat (Wunsch Mario, 31.10.2026) */
    /* Neues Café-Foto vollständig, ohne Beschnitt (Mario, Designwerkstatt, 03.11.2026) */
    .arbeit-foto { grid-area: foto; width: 100%; max-width: 420px; height: auto; }
    #wer-ich-bin + #fuer-wen .block { padding-top: 160px; }
    @media (max-width: 760px) {
      .wer-raster { grid-template-columns: minmax(0, 1fr); grid-template-areas: "zitat" "text" "foto"; row-gap: 40px; }
      .wer-foto { max-width: 280px; margin-bottom: -160px;
        -webkit-mask-image: linear-gradient(to bottom, #000 calc(100% - 64px), rgba(0, 0, 0, 0.92) calc(100% - 48px), rgba(0, 0, 0, 0.35) calc(100% - 20px), transparent 100%);
        mask-image: linear-gradient(to bottom, #000 calc(100% - 64px), rgba(0, 0, 0, 0.92) calc(100% - 48px), rgba(0, 0, 0, 0.35) calc(100% - 20px), transparent 100%); }
      .arbeit-foto { max-width: 320px; }
      #wer-ich-bin + #fuer-wen .block { padding-top: 128px; }
    }
    .spalte { display: flex; flex-direction: column; gap: 20px; }

    .block { max-width: var(--max); margin: 0 auto; padding: 96px var(--gutter); display: flex; flex-direction: column; gap: 48px; }
    .block-kopf { display: flex; flex-direction: column; gap: 16px; max-width: 640px; }
    .block-kopf p { color: var(--text-muted); }
    .karten { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
    .karte { background: var(--bg-raised); padding: 32px; display: flex; flex-direction: column; gap: 12px; }
    .karte .nr { font-family: var(--font-display); font-size: 15px; color: var(--accent); }
    .karte p { color: var(--text-muted); font-size: 16px; }
    .schluss-zitat { font-family: var(--font-display); font-weight: 300; font-size: clamp(28px, 3.5vw, 36px); line-height: 1.2; max-width: 760px; }
    /* Angebote je Bereich (Mario, 02.11.2026) */
    .uebergang { font-family: var(--font-display); font-weight: 300; font-size: 24px; line-height: 1.35; color: var(--text); max-width: 760px; }
    .angebote-reihe { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 24px; }
    .angebot-neu { background: var(--bg-raised); padding: 32px; display: flex; flex-direction: column; gap: 12px; }
    .angebot-neu .nr { font-family: var(--font-display); font-size: 15px; line-height: 24px; color: var(--accent); }
    .angebot-neu h3 { font-size: 26px; line-height: 1.2; }
    .angebot-neu p { color: var(--text-muted); font-size: 16px; }
    @media (max-width: 760px) { .uebergang { font-size: 20px; } .angebot-neu { padding: 24px 20px; } .angebot-neu h3 { font-size: 24px; } }
    /* Roter Faden: markierte Worte in Orange, im Fließtext halbfett, nicht umbrechen (Mario, 02.11.2026) */
    .m { color: var(--accent); font-weight: 600; white-space: nowrap; }
    .leitsatz .m, .schluss-zitat .m { font-weight: inherit; }
    :global(#inhalt) { position: relative; }
    .faden { position: absolute; inset: 0; pointer-events: none; z-index: 5; overflow: hidden; }
    .faden svg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; overflow: visible; }
    .faden :global(.faden-punkt) { position: absolute; border-radius: 50%; background: var(--accent); }
    /* Unter 1184 px ist links kein Platz für den Faden mit Ausläufern: Linie am Rand, Text rückt etwas ein */
    @media (max-width: 1183px) {
      :global(#inhalt .wrap), :global(#inhalt .block), .trenner { padding-left: 28px; }
    }

    /* Link-Kette durch die Faden-Worte (Mario, Designwerkstatt, 03.11.2026). Die drei Karten und das Zitat führen alle zur
       Angebotskarte 01 (Mario, 03.11.2026): 1 → 2, 2 bis 5 → 6, 6 → 7 → 8 → 1. */
    .kette { color: var(--accent); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; text-decoration-color: var(--accent); scroll-margin-top: 35vh; }
    .kette:hover, .kette:hover .m { color: var(--accent-hover); text-decoration-color: var(--accent-hover); }
    /* Die vier Fragen nach „Wie ich arbeite“ */
    .vier-fragen { display: flex; flex-direction: column; gap: 16px; max-width: 1040px; margin-top: 48px; }
    .vier-fragen p { font-family: var(--font-display); font-weight: 300; font-size: 30px; line-height: 1.35; color: var(--text); }
    .vier-fragen .antwort { color: var(--text-faint); }
    .vier-fragen .vier-strich { margin: 24px 0; }
    .vier-fragen .vier-letzte { font-size: 40px; line-height: 1.25; letter-spacing: -0.01em; }
    .vier-letzte .m { font-weight: inherit; }
    @media (max-width: 760px) {
      .vier-fragen { gap: 14px; margin-top: 8px; }
      .vier-fragen p { font-size: 20px; }
      .vier-fragen .vier-strich { margin: 12px 0; }
      .vier-fragen .vier-letzte { font-size: 26px; }
      #wie-ich-arbeite .block { padding-bottom: 64px; }
    }
    .angebot-karten { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; align-items: start; }
    .angebot-karte { background: var(--bg-raised); padding: 36px; display: flex; flex-direction: column; gap: 14px; }
    .angebot-karte h3 { font-size: 30px; }
    .angebot-karte p { color: var(--text-muted); font-size: 16px; }
    .angebot-karte .preis { font-family: var(--font-display); font-size: 40px; color: var(--accent); line-height: 1.1; }
    .klein { font-size: 14px; color: var(--text-faint); }
    .preise-auf details { border-top: 1px solid var(--line-strong); }
    .preise-auf summary { cursor: pointer; list-style: none; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .preise-auf summary::-webkit-details-marker { display: none; }
    .preise-auf summary::after { content: '+'; font-family: var(--font-display); font-size: 28px; color: var(--accent); }
    .preise-auf details[open] summary::after { content: '−'; }
    .preise-kopf { display: flex; flex-direction: column; line-height: 1.3; }
    .preise-name { font-family: var(--font-display); font-size: 22px; color: var(--text); }
    .preise-ab { font-size: 15px; color: var(--text-faint); }
    .preise-auf ul { list-style: none; margin: 0 0 12px; padding: 0; font-size: 16px; color: var(--text-muted); }
    .preise-auf li { display: flex; justify-content: space-between; gap: 16px; padding: 8px 0; border-bottom: 1px solid #2E2923; }
    .preise-betrag { color: var(--text); white-space: nowrap; }
    /* Meine Geschichte: zwei Spalten wie bei „Wer ich bin“ (Mario, Designwerkstatt, 02.11.2026) */
    .geschichte-raster { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 400px); column-gap: 72px; row-gap: 40px; align-items: center; }
    .geschichte-raster .spalte { max-width: 680px; }
    .geschichte-foto { width: 100%; max-width: 400px; aspect-ratio: 1 / 1; object-fit: cover; }
    @media (max-width: 760px) { .geschichte-raster { grid-template-columns: minmax(0, 1fr); } }
    .wo { display: flex; flex-direction: column; gap: 16px; max-width: 680px; }
    .wo p { color: var(--text-muted); }

    .fragen { max-width: 760px; }
    .fragen details { border-top: 1px solid var(--line); padding: 8px 0; }
    .fragen details:last-child { border-bottom: 1px solid var(--line); }
    .fragen summary { cursor: pointer; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 16px; list-style: none; }
    .fragen summary::-webkit-details-marker { display: none; }
    .fragen summary::after { content: '+'; font-family: var(--font-display); font-size: 28px; color: var(--accent); }
    .fragen details[open] summary::after { content: '−'; }
    .fragen summary h3 { font-size: 22px; }
    .fragen .antwort { display: flex; flex-direction: column; gap: 12px; color: var(--text-muted); padding: 4px 0 20px; }

    .kontakt { border-top: 1px solid var(--line); }
    .kontakt .wrap { padding-top: 112px; padding-bottom: 112px; }
    .kontakt h2 { font-weight: 300; font-size: clamp(40px, 6vw, 64px); line-height: 1.05; max-width: 760px; }
    .kontakt .spalte p { color: var(--text-muted); max-width: 560px; }
    .kontakt-daten { display: flex; flex-direction: column; gap: 4px; font-size: 20px; }
    .kontakt-foto { max-width: 400px; }
  </style>

  <!-- Roter Faden, rein dekorativ (Entwurf der Designwerkstatt, freigegeben von Mario am 02.11.2026) -->
  <div class="faden" aria-hidden="true"><svg><path fill="none" stroke="#D49A5A" stroke-linecap="round" /></svg></div>

  <!-- 2. Einstieg mit H1 -->
  <section class="hero" aria-label="Einstieg">
    <div class="wrap">
      <div class="hero-text">
        <!-- Einstieg Variante B aus dem Design-Canvas, Wortlaut Textwerkstatt (Mario, 02.11.2026) -->
        <p class="uhrzeit">3 Uhr 33. Du hast schon wieder Ja gesagt.</p>
        <span class="einstieg-strich" aria-hidden="true"></span>
        <p class="leitsatz" data-zone>Landest du <a class="kette" id="faden-1" href="#faden-2" aria-label="immer wieder, weiter zur nächsten Stelle"><span class="m" data-mark>immer wieder</span></a> an derselben Stelle?</p>
        <p class="leitzeile">Im Job, in der Führung, in der Familie, in der Liebe.</p>
      </div>
      <div class="hero-foto">
        <Image src={fotoEinstieg} alt="Mario Wochner lächelt in die Kamera, am Seeufer" width={800} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" loading="eager" />
      </div>
      <div class="actions hero-aktionen">
        <a class="textlink" href="#wer-ich-bin">Wer ich bin</a>
        <a class="button" href={buchung}>Kostenloses Erstgespräch</a>
      </div>
    </div>
  </section>

  <!-- Szene, eigener Block unter dem Einstieg -->
  <section class="szene" aria-label="Kennst du das Gefühl?">
    <div class="wrap">
      <div class="stack">
        <p>Kennst du das Gefühl? Nach einem Gespräch denkst du: Verdammt, warum habe ich nicht diesen Satz gesagt? Warum konnte ich an der Stelle nicht für mich einstehen? Und jetzt habe ich wieder nur Ja gesagt.</p>
        <p>Danach bist du wütend, frustriert oder traurig. Eigentlich weißt du ganz genau, wie du hättest reagieren können. Aber im Moment kannst du darauf nicht zugreifen.</p>
        <p class="gedanke">Warum passiert mir immer das Gleiche?</p>
        <p>Es ist immer wieder dasselbe Muster, im Job wie in Beziehungen. Ich schaue mit dir genau darauf: woran es liegt und wo du es findest. Genau das ist die Stelle, wo du selbst vorkommst. Und die wird durch dein eingespurtes Verhalten ständig überfahren. Und hinterher fällt dir wieder ein, was du hättest sagen können.</p>
      </div>
    </div>
  </section>

  <!-- 3. Wer ich bin, kurz -->
  <section id="wer-ich-bin" class="hell">
    <div class="wrap wer-raster">
      <p class="gross-zitat">„Ich coache aus Erfahrung.“</p>
      <Image class="wer-foto" src={fotoGeschichte} alt="Mario Wochner lehnt an seinem Auto auf einer Wiese an einem Fluss" width={680} widths={[340, 680]} sizes="(max-width: 760px) 280px, 340px" />
      <div class="spalte">
        <h2 class="label">Wer ich bin</h2>
        <p>Rund 30 Jahre Handwerk, Selbstständigkeit und Projektleitung. Irgendwann habe ich mich selbst zu meinem größten Projekt gemacht. Ich wollte wissen, wo ich in meinen eigenen Beziehungen vorkomme.</p>
        <p><strong>So habe ich meine Antwort gefunden. Mich.</strong></p>
        {GESCHICHTE_SICHTBAR && <div class="actions"><a href="/meine-geschichte" class="button">Meine Geschichte …</a></div>}
      </div>
    </div>
  </section>

  <!-- 4. Für wen das ist -->
  <section id="fuer-wen">
    <div class="block">
      <div class="block-kopf">
        <p class="label">Für wen das ist</p>
        <h2>Beziehung meint mehr als Partnerschaft.</h2>
        <p>Und Partnerschaft ist nicht nur Romantik. Geschäftspartner zum Beispiel. Muster tauchen überall dort auf, wo Menschen miteinander in Berührung kommen. Ich gehe mit dir durch die Stelle, wo Muster sich scheinbar nicht durchbrechen lassen.</p>
      </div>
      <div class="karten">
        <div class="karte" data-zone>
          <span class="nr">01</span>
          <h3>Arbeit und Führung</h3>
          <p>Du stehst vor deinem Vorgesetzten, deiner Vorgesetzten, und sagst <a class="kette" id="faden-2" href="#faden-6" aria-label="wieder Ja, weiter zur nächsten Stelle"><span class="m" data-mark>wieder Ja</span></a>, obwohl du die Zeit für dich geplant hattest. Oder du führst ein Team und weichst dem Konflikt aus, damit die Harmonie stehen bleibt.</p>
        </div>
        <div class="karte" data-zone>
          <span class="nr">02</span>
          <h3>Familie</h3>
          <p>Beim Besuch bei deinen Eltern bist du nach zehn Minuten <a class="kette" id="faden-3" href="#faden-6" aria-label="wieder das Kind, weiter zur nächsten Stelle"><span class="m" data-mark>wieder das Kind</span></a> von früher. Oder mit deinem Kind in der Pubertät zählst du die Eskalationen nicht mehr pro Woche, sondern pro Tag. Und viel zu oft denkst du: Verdammt noch mal, wieso ist das immer das Gleiche?</p>
        </div>
        <div class="karte" data-zone>
          <span class="nr">03</span>
          <h3>Freundschaft und Liebe</h3>
          <p>Im Konflikt mit deinem Partner, deiner Partnerin, <a class="kette" id="faden-4" href="#faden-6" aria-label="fühlst du, wie du, weiter zur nächsten Stelle"><span class="m" data-mark>fühlst du, wie du</span></a> kleiner wirst. Du weißt genau, was du brauchst, aber es kommt dir nicht über die Lippen. Deinen Freunden gibst du gerne. Und wie oft ertappst du dich bei dem Gedanken: Sag mal, geht das hier alles eigentlich immer nur noch einseitig? Oder sehe ich es nicht richtig?</p>
        </div>
      </div>
      <p class="schluss-zitat" data-zone>„An welcher <a class="kette" id="faden-5" href="#faden-6" aria-label="Stelle, weiter zur nächsten Stelle"><span class="m" data-mark>Stelle</span></a> kommst du eigentlich selbst vor?“</p>
      <!-- Angebote je Bereich, Entwurf „Roter Faden · fünf Stellen“, freigegeben von Mario am 02.11.2026 -->
      <p class="uebergang">Die Stelle ist eigentlich überall dieselbe. Nur die Themen geben ihr immer wieder ein neues Bild. Die Art, wie wir hinschauen, bleibt gleich.</p>
      <div class="angebote-reihe">
        <div class="angebot-neu" data-zone id="fuehrung-kommunikation">
          <span class="nr">01 · Mein Angebot</span>
          <h3>Führungscoaching und Kommunikationstraining</h3>
          <p>Zwischen Halle und Führungsebene landen Gespräche oft <a class="kette" id="faden-6" href="#faden-7" aria-label="immer wieder, weiter zur nächsten Stelle"><span class="m" data-mark>immer wieder</span></a> an derselben Stelle. Dabei wollen beide Seiten dasselbe: ein gutes Ergebnis für ihren Einsatz. Was im Missverständnis zerrieben wird, ist weg, und es kostet jedes Mal neu, solange das Muster bleibt. Ich kenne beide Seiten, aus 30 Jahren Handwerk, Selbstständigkeit und Projektleitung. Wir schauen genau auf diese Stelle und üben, dort für dich einzustehen, auch im Rollenspiel. Wie wir das aufbauen, klären wir im Erstgespräch.</p>
        </div>
        <div class="angebot-neu" data-zone id="familiencoaching">
          <span class="nr">02 · Mein Angebot</span>
          <h3>Familiencoaching</h3>
          <p>Ob mit den Eltern, den Kindern oder unter Geschwistern: Wo du in der Familie <span class="m" data-mark>immer wieder</span> an derselben Stelle landest, wirken oft Muster, die älter sind als du. Wir schauen gemeinsam darauf, wo du darin vorkommst. Ob weitere aus deiner Familie dazukommen und was es kostet, klären wir im Erstgespräch.</p>
        </div>
        <div class="angebot-neu" data-zone id="konflikt-paar-beziehung">
          <span class="nr">03 · Mein Angebot</span>
          <h3>Konflikt-, Paar- und Beziehungscoaching</h3>
          <p>Ob im Konflikt oder in einer Beziehung, im Job, in der Familie oder in der Paardynamik: Wo es zwischen Menschen <span class="m" data-mark>immer wieder</span> an derselben Stelle hakt, steckt oft ein Muster dahinter. Als Paar könnt ihr auch zu zweit kommen, ab 110 € für 60 Minuten. Wie wir das aufbauen, klären wir im Erstgespräch.</p>
        </div>
      </div>
    </div>
  </section>

  <div class="trenner"><div></div></div>

  <!-- 5. Wie ich arbeite (mit dem Kernsatz aus „Mein Ansatz") -->
  <section id="wie-ich-arbeite">
    <div class="block">
      <div class="wer-raster">
        <p class="gross-zitat zitat-dreizeilig"><span>„Was ich kann?</span><span class="mittig">Bleiben …</span><span class="mittig">Bleiben, wenn es eng wird!“</span></p>
        <Image class="arbeit-foto" src={fotoCafe} alt="Mario Wochner im Porträt, in einem Straßencafé" width={830} widths={[420, 830]} sizes="(max-width: 760px) 320px, 420px" />
        <div class="spalte">
          <p class="label">Wie ich arbeite</p>
          <h2>Nicht nur warum. Vor allem wie und wo.</h2>
          <p class="muted">Du kennst dein Thema und die Herausforderung, die du damit hast. Du hast Bücher gelesen und Fortbildungen besucht. Warst du sogar schon mal bei einem Coach oder zu einer Gesprächstherapie? Hast du schon mal gedacht: ‚Nichts davon hat geholfen.‘? Das Muster dahinter entdecken wir gemeinsam. Den Weg daraus gehst du.</p>
          <p class="muted">Das Warum erklärt, was passiert ist. Wir schauen, wie es jetzt ist. Und wo das ist, was auf deinem Weg bis hierhin verloren gegangen ist oder noch nicht gefunden wurde. Dort fangen wir an.</p>
          <p class="muted">Mir ist wichtig, dass wir nicht nur auf dein Thema schauen, sondern vor allem, wie es dir damit geht. Was erlebst du damit? Wie fühlst du dich damit? Denn wenn sich dein Erleben dazu ändert, dann fühlst du es auch. Und das wirkt deutlich mehr in dir als jede Kopfgeburt. Dann ist es nicht nur an deiner Oberfläche, sondern so, dass du wirklich überzeugt bist, in der Arbeit mit mir echt was in dir gefunden zu haben.</p>
          <p class="muted">Am Anfang gehört der Raum dir. Ich höre zu: was in dir brennt, was dir auf der Leber liegt. Nicht nur, bis ich verstanden habe, worum es geht. Sondern bis ich eine Ahnung habe, wie es sich für dich anfühlt. Und wo. Ich wiederhole, was ich dabei von dir verstehe. Und du sagst mir, ob es stimmt. Ich frage nach dem, was du nebenbei sagst. Nach dem halben Satz, den du nicht zu Ende bringst. Dann suchen wir den Moment in deinem Leben, an dem das, was du heute brauchst, schon einmal funktioniert hat. Meistens muss nichts Neues erfunden werden. Es muss wiedergefunden werden. Ich biete dir auch an, dass wir es gleich hier ausprobieren. Am Ende hast du einen Schritt für den nächsten Tag. Etwas, das du wirklich umsetzen kannst. Von dir formuliert und von dir selbst gefunden.</p>
          <p class="muted">Wenn du merkst, dass sich beim Lesen etwas in dir bewegt, ist das ein sehr gutes Zeichen dafür, dass du bei mir richtig bist.</p>
          <p class="muted">Ich bin systemischer Coach, {ZERTIFIKAT_ERHALTEN ? '' : 'ab 6.11. '}zertifiziert von der IHK und von InKonstellation, und geschult im Umgang mit unterschiedlichen Methoden, unter anderem zu Konflikten, inneren Anteilen und Emotionen. Daraus ist meine eigene Art zu arbeiten entstanden. Welche Methode passt, klären wir im Erstgespräch.</p>
          <p class="muted" data-zone>Ich finde mit dir <a class="kette" id="faden-7" href="#faden-8" aria-label="die Stelle, weiter zur nächsten Stelle"><span class="m" data-mark>die Stelle</span></a>, an der ein Teil von dir feststeckt und nicht weiterkommt. Danach kennst du den Weg, den ich mit dir dahin gegangen bin, und kannst ihn selber nochmal gehen. Und vor allem findest du die Antwort auf dein Thema dann in dir selbst wieder. Jedes Mal wieder.</p>
          <p><strong>Mein Ziel ist, dass du mich danach nicht mehr brauchst.</strong></p>
          <p class="muted">Ich bin mit dir zwar ein Stück gegangen, <strong>den Weg selbst bist aber du gegangen.</strong></p>
        </div>
      </div>
      <!-- Die vier Fragen, ohne Überschrift (Mario, Textwerkstatt und Designwerkstatt, 03.11.2026) -->
      <div class="vier-fragen">
        <p>Ist dein Thema eine Frage? <span class="antwort">Dann kann deine Antwort sichtbar werden.</span></p>
        <p>Ist dein Thema eine Entscheidung? <span class="antwort">Dann kann ein Weg sichtbar werden.</span></p>
        <p>Ist dein Thema eine Unsicherheit? <span class="antwort">Dann kann Orientierung sichtbar werden.</span></p>
        <span class="einstieg-strich vier-strich" aria-hidden="true"></span>
        <p class="vier-letzte" data-zone>Ist dein Thema ein Muster oder ein Verhalten? Dann wird es richtig spannend. Denn an der <a class="kette" id="faden-8" href="#faden-1" aria-label="Stelle bist du. Versteckt., zurück zum Anfang"><span class="m" data-mark>Stelle</span> bist du. Versteckt.</a></p>
      </div>
    </div>
  </section>

  <div class="trenner"><div></div></div>

  <!-- 6. Angebot und Preise -->
  <section id="angebot">
    <div class="block">
      <div class="block-kopf">
        <h2>Mein Angebot</h2>
        <p>Einzelcoaching für Menschen, die für sich selbst Verantwortung übernehmen wollen, aber gemerkt haben, dass mehr Druck nicht die Lösung ist.</p>
      </div>
      <!-- Reihenfolge: Erstgespräch, Zahl, was du kannst, Preise (Mario, Designwerkstatt, 01.11.2026) -->
      <div class="angebot-karten">
        <div class="angebot-karte">
          <p class="label">Zum Kennenlernen</p>
          <h3>Erstgespräch</h3>
          <p class="preis">kostenlos</p>
          <p>Das Erstgespräch ist kostenlos und unverbindlich. Online, per Telefon oder vor Ort. Es dauert 20 bis 30 Minuten.</p>
        </div>
        <div class="angebot-karte" id="zahl-was-du-kannst">
          <p class="label">8 Termine im Monat</p>
          <h3>Zahl, was du kannst</h3>
          <p>Coaching ist für mich mehr als nur ein Job. Es ist Berufung und Haltung. Ich lebe dafür. Und ich muss auch davon leben können. Trotzdem soll Coaching nicht nur an der Frage hängen, <strong>ob du es dir leisten kannst</strong>. Deshalb halte ich jeden Monat 8 Termine frei, <strong>bei denen du selbst festlegst, was du zahlst.</strong> Alle Termine vereinbaren wir im Erstgespräch.</p>
        </div>
        <div class="angebot-karte">
          <p class="label">Begleitung</p>
          <h3>Preise</h3>
          <!-- Preise zum Aufklappen, geschlossen beim Laden; die Preise stehen trotzdem im Quelltext (Mario, Designwerkstatt, 02.11.2026) -->
          <div class="preise-auf">
            {[['Einzelcoaching', SITE.preise.einzel], ['Paarcoaching', SITE.preise.paar]].map(([name, liste]) => (
              <details>
                <summary><span class="preise-kopf"><span class="preise-name">{name}</span><span class="preise-ab">ab {Math.min(...Object.values(liste))} €</span></span></summary>
                <ul>
