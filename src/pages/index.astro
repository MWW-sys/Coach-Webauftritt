  <!-- 7. Meine Geschichte (Verweis auf die Unterseite). Text links, Foto aus dem Arbeitszimmer rechts, am Handy darunter (Mario, Designwerkstatt, 02.11.2026). -->
  {GESCHICHTE_SICHTBAR && (
  <section id="geschichte" class="hell">
    <div class="wrap geschichte-raster">
      <div class="spalte">
        <p class="label">Meine Geschichte</p>
        <h2>Das Einzige, was in allen meinen Beziehungen immer gleich war, bin ich.</h2>
        <p>Ich liege im Wohnmobil auf dem Sofa und schaue schräg durch das Fenster in die Baumkronen. Ich denke, es muss ein schöner Tag draußen sein. Und hier drin liege ich wie festgenagelt.</p>
        <a href="/meine-geschichte" class="textlink">Weiterlesen</a>
      </div>
      <Image class="geschichte-foto" src={fotoArbeitszimmer} alt="Mario Wochner am Schreibtisch mit Notizbuch" width={800} widths={[400, 800]} sizes="(max-width: 760px) 100vw, 400px" />
    </div>
  </section>
  )}

  <!-- 8. Häufige Fragen -->
  <section id="fragen">
    <div class="block">
      <h2>Häufige Fragen</h2>
