  <!-- 9. Kontakt -->
  <section id="kontakt" class="kontakt">
    <div class="wrap zweispaltig">
      <div class="spalte">
        <h2>Schreib mir, wo es sich bei dir wiederholt.</h2>
        <p>Wenn du das Gefühl hast, hier könnte etwas anfangen. Schreib mir. Ich antworte persönlich. Und nicht mit einer Vorlage. Eine Antwort von mir braucht einen Werktag.</p>
        <div class="kontakt-daten">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={`tel:${SITE.phone}`}>{SITE.phoneDisplay}</a>
        </div>
        <div class="actions"><a class="button" href={mailErstgespraech}>Kostenloses Erstgespräch</a></div>
      </div>
      <Image class="kontakt-foto" src={fotoKontakt} alt="Mario Wochner am Seeufer, mit Blick über die Schulter" width={800} widths={[400, 800]} sizes="(max-width: 700px) 100vw, 400px" />
    </div>
  </section>
  <script>
    // Roter Faden: Linie und Punkte werden im Browser an die markierten Worte gelegt, damit sie bei jeder
    // Breite stimmen. Vorlage: FadenRechner.dc.html und FadenHandy.dc.html aus dem Design-Canvas (02.11.2026).
    const wurzel = document.getElementById('inhalt');
    const ebene = document.querySelector<HTMLElement>('.faden');
    const pfad = ebene?.querySelector('path');
    const breit = window.matchMedia('(min-width: 1184px)');
    const f = (n: number) => Math.round(n * 10) / 10;
    type Stelle = { l: number; r: number; t: number; b: number; zl: number; zr: number; zt: number; zb: number };

    // Rechner (Feintuning Mario, 02.11.2026): eine gerade Linie 40 px links der Inhaltskante, ein Punkt auf Höhe
    // jeder Markierung (fast gleich hohe nur einmal), am Ende ein Bogen zu „die Stelle“ mit Punkt.
    // Faden weiter (Mario, Designwerkstatt, 03.11.2026): vom Punkt bei „die Stelle“ läuft die Linie auf derselben
    // Höhe nach rechts bis 40 px rechts der Textspalte, im Bogen hinunter, im Bogen nach links und endet unter dem
    // letzten e von „Stelle“ in den vier Fragen. Vorlage: build() in FadenWeiter.dc.html.
    function bauRechner(p: Stelle[], X: number) {
      const C = 34;
      const q = p.slice().sort((a, b) => a.t - b.t);
      const b = q[q.length - 1];
      const a = q[q.length - 2];
      const mitte = (m: Stelle) => (m.t + m.b) / 2;
      const ya = a.b + 5;
      const yb = b.b + 5;
      const R = a.zr + 40;
      const xe = b.r - 10;
      const hoehen: number[] = [];
      q.slice(0, -2).forEach((m) => { const y = mitte(m); if (!hoehen.length || Math.abs(hoehen[hoehen.length - 1] - y) > 16) hoehen.push(y); });
      const y0 = hoehen.length ? hoehen[0] : ya - C;
      const d = 'M ' + f(X) + ' ' + f(y0) + ' L ' + f(X) + ' ' + f(ya - C) + ' Q ' + f(X) + ' ' + f(ya) + ' ' + f(X + C) + ' ' + f(ya)
        + ' L ' + f(R - C) + ' ' + f(ya) + ' Q ' + f(R) + ' ' + f(ya) + ' ' + f(R) + ' ' + f(ya + C)
        + ' L ' + f(R) + ' ' + f(yb - C) + ' Q ' + f(R) + ' ' + f(yb) + ' ' + f(R - C) + ' ' + f(yb) + ' L ' + f(xe) + ' ' + f(yb);
      const punkte = hoehen.map((y) => ({ x: X - 4, y: y - 4, g: 8 }));
      punkte.push({ x: a.l - 4, y: ya - 4, g: 8 });
      punkte.push({ x: xe - 4, y: yb - 4, g: 8 });
      return { d, punkte };
    }

    function bauHandy(p: Stelle[]) {
      const X = 10;
      const ys = p.map((q) => (q.t + q.b) / 2);
      return { d: 'M ' + X + ' ' + f(ys[0]) + ' L ' + X + ' ' + f(ys[ys.length - 1]), punkte: ys.map((y) => ({ x: X - 6, y: y - 6, g: 12 })) };
    }

    let letzte = '';
    function messen() {
      if (!wurzel || !ebene || !pfad) return;
      const wb = wurzel.getBoundingClientRect();
      const stellen: Stelle[] = Array.from(wurzel.querySelectorAll<HTMLElement>('[data-mark]')).map((el) => {
        const r = el.getClientRects()[0] || el.getBoundingClientRect();
        const z = (el.closest('[data-zone]') || el).getBoundingClientRect();
        return { l: r.left - wb.left, r: r.right - wb.left, t: r.top - wb.top, b: r.bottom - wb.top, zl: z.left - wb.left, zr: z.right - wb.left, zt: z.top - wb.top, zb: z.bottom - wb.top };
      });
      if (!stellen.length) return;
      // Inhaltskante = linke Kante des Leitsatzes; die Senkrechte läuft 40 px links davon
      const kante = stellen[0].zl;
      const ergebnis = breit.matches && kante - 40 >= 12 ? bauRechner(stellen, kante - 40) : bauHandy(stellen);
      const schluessel = ergebnis.d;
      if (schluessel === letzte) return;
      letzte = schluessel;
      const amRechner = ergebnis.punkte[0]?.g === 8;
      pfad.setAttribute('d', ergebnis.d);
      pfad.setAttribute('stroke-width', amRechner ? '1.5' : '2');
      pfad.setAttribute('opacity', amRechner ? '0.9' : '1');
      ebene.querySelectorAll('.faden-punkt').forEach((n) => n.remove());
      ergebnis.punkte.forEach((q) => {
        const n = document.createElement('span');
        n.className = 'faden-punkt';
        n.style.cssText = `left:${f(q.x)}px;top:${f(q.y)}px;width:${q.g}px;height:${q.g}px`;
        ebene.appendChild(n);
      });
    }
    messen();
    document.fonts?.ready.then(messen);
    window.addEventListener('load', messen);
    setTimeout(messen, 400);
    setTimeout(messen, 1500);
    if ('ResizeObserver' in window && wurzel) new ResizeObserver(() => messen()).observe(wurzel);
    breit.addEventListener?.('change', messen);
  </script>
</Layout>
